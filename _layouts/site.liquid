<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% capture full_name %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
    <title>{% if page.permalink == '/' %}{{ full_name }}{% else %}{{ page.title }} · {{ full_name }}{% endif %}</title>
    <meta name="author" content="{{ full_name }}">
    <meta name="description" content="{{ page.description | default: site.description | strip_newlines | strip }}">
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121418" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="light dark">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
    >
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}">
    <script src="{{ '/assets/js/attractor.js' | relative_url }}" defer></script>
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    <header class="topbar">
      <div class="wrap topbar-inner">
        {% if page.permalink == '/' %}
          <span class="brand"><span class="brand-dot"></span>{{ full_name }}</span>
        {% else %}
          <a class="brand" href="{{ '/' | relative_url }}"><span class="brand-dot"></span>{{ full_name }}</a>
        {% endif %}
        <nav aria-label="Main">
          <ul>
            <li>
              <a href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}class="is-active" aria-current="page"{% endif %}>About</a>
            </li>
            {% assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
            {% for p in nav_pages %}
              <li>
                <a href="{{ p.url | relative_url }}" {% if page.url == p.url %}class="is-active" aria-current="page"{% endif %}>
                  {{- p.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      </div>
    </header>

    <main id="content">
      {% if page.attractor %}
        <div class="flow{% if page.permalink == '/' %} flow--hero{% endif %}" data-system="{{ page.attractor }}" data-x="{{ page.attractor_x | default: 0.76 }}" data-size="{{ page.attractor_size | default: 0.33 }}" data-y="{{ page.attractor_y | default: 0.52 }}" aria-hidden="true">
          <canvas class="flow-back"></canvas>
          <canvas class="flow-front"></canvas>
        </div>
      {% endif %}
      {% if page.permalink != '/' %}
        <header class="wrap page-head">
          <h1 class="page-title">{{ page.title }}</h1>
          {% if page.intro %}<p class="page-intro">{{ page.intro }}</p>{% endif %}
          {% if page.attractor %}<div class="knobs"></div>{% endif %}
        </header>
      {% endif %}
      <div class="wrap">
        {{ content }}
      </div>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p>© {{ site.time | date: '%Y' }} {{ full_name }}</p>
        <p class="ring">
          <a href="https://www.gas-abel.fr/" target="_self" aria-label="Previous site in the webring">🍝 <span aria-hidden="true">←</span></a>
          <span>Webring des <em>délices</em></span>
          <a href="https://gaetanserre.fr" target="_self" aria-label="Next site in the webring"><span aria-hidden="true">→</span> 🍜</a>
        </p>
      </div>
    </footer>
  </body>
</html>
